[Unit]
Description=Remove expired Depth Motion jobs

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_GROUP@
ExecStart=/usr/bin/find /var/lib/depth-motion/jobs -mindepth 1 -maxdepth 1 -type d -mtime +7 -exec /usr/bin/rm -rf {} +
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/depth-motion/jobs
